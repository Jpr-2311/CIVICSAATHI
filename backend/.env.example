# ── Runtime ────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call this API.
# Wildcards are never allowed; production origins must use HTTPS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://your-frontend.vercel.app

# ── Google Gemini (Day 4, live) ───────────────────────────
# Never commit real keys. Server-side only; never exposed to the browser.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ── Supabase PostgreSQL (deferred) ────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Persistent storage ────────────────────────────────────
# Absolute root of a mounted persistent disk in production, e.g.
# PERSISTENT_DATA_DIR=/data/civicsaathi
# ChromaDB and uploaded documents are then stored under:
#   <PERSISTENT_DATA_DIR>/chroma
#   <PERSISTENT_DATA_DIR>/documents
# Leave unset for local development. Production requires this variable or
# both absolute CHROMA_PERSIST_DIR and DOCUMENT_STORAGE_DIR overrides.
# PERSISTENT_DATA_DIR=

# ── ChromaDB (Day 3) ──────────────────────────────────────
# Relative paths resolve against backend/, not the process working directory.
CHROMA_PERSIST_DIR=.chroma
DOCUMENT_COLLECTION_NAME=civicsaathi_government_documents

# ── Document ingestion (Day 3) ────────────────────────────
# Paths are server-side only and never returned by the API.
# DOCUMENT_STORAGE_DIR=data/documents
# DOCUMENT_MAX_UPLOAD_BYTES=10485760
# DOCUMENT_MAX_PAGES=100
# DOCUMENT_CHUNK_CHARS=1200
# DOCUMENT_CHUNK_OVERLAP_CHARS=200
# DOCUMENT_MIN_CHUNK_CHARS=40
# DOCUMENT_OCR_MIN_PAGE_CHARS=80
# DOCUMENT_SEARCH_TOP_K=5
# DOCUMENT_SEARCH_MAX_TOP_K=20
# DOCUMENT_SEARCH_MAX_DISTANCE=1.0

# Multilingual embedding model (downloaded once, then cached locally).
# intfloat/multilingual-e5-small supports English, Malayalam and Hindi.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# ── Assistant retrieval and generation (Day 4) ────────────
# Bounded retrieval; leave the similarity gate documented as a heuristic.
# ASSISTANT_TOP_K=5
# ASSISTANT_MIN_SIMILARITY=0.30
# ASSISTANT_MAX_EVIDENCE_CHUNKS=5
# ASSISTANT_MAX_CONTEXT_CHARS=12000
ASSISTANT_REQUEST_TIMEOUT_SECONDS=90
# ASSISTANT_MAX_OUTPUT_TOKENS=900

# Bounded retries for transient Gemini 429/503/504 failures (all seconds).
# The retry budget is the total allowance for all attempts plus backoff and
# must exceed ASSISTANT_REQUEST_TIMEOUT_SECONDS above. The backoff budget caps
# cumulative sleep and must be at least ASSISTANT_RETRY_MAX_DELAY_SECONDS.
# Retry-After hints larger than the max delay are intentionally capped.
# ASSISTANT_MAX_ATTEMPTS=3
# ASSISTANT_RETRY_BUDGET_SECONDS=270
# ASSISTANT_RETRY_BACKOFF_BUDGET_SECONDS=10
# ASSISTANT_RETRY_BASE_DELAY_SECONDS=0.25
# ASSISTANT_RETRY_MAX_DELAY_SECONDS=2
