# ── Secrets ────────────────────────────────────────────────
# Never commit real credentials. Examples are safe to commit.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# ── Node / Vite ────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Generated and local-only data ──────────────────────────
backend/.chroma/
uploads/
*.sqlite3

# ── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editors ───────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
